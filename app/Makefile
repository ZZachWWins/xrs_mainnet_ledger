ifeq ($(BOLOS_SDK),)
$(error Environment variable BOLOS_SDK is not set)
endif

include $(BOLOS_SDK)/Makefile.defines

APPNAME      = "Xeris"
APPVERSION_M = 1
APPVERSION_N = 0
APPVERSION_P = 0
APPVERSION   = "$(APPVERSION_M).$(APPVERSION_N).$(APPVERSION_P)"

APP_LOAD_PARAMS  = --curve ed25519
APP_LOAD_PARAMS += --path "44'/9000'"
APP_LOAD_PARAMS += --appFlags 0x240
APP_LOAD_PARAMS += $(COMMON_LOAD_PARAMS)

DEFINES += APPNAME=\"$(APPNAME)\"
DEFINES += APPVERSION=\"$(APPVERSION)\"
DEFINES += APPVERSION_M=$(APPVERSION_M)
DEFINES += APPVERSION_N=$(APPVERSION_N)
DEFINES += APPVERSION_P=$(APPVERSION_P)
DEFINES += LEDGER_MAJOR_VERSION=$(APPVERSION_M)
DEFINES += LEDGER_MINOR_VERSION=$(APPVERSION_N)
DEFINES += LEDGER_PATCH_VERSION=$(APPVERSION_P)

DEFINES += OS_IO_SEPROXYHAL
DEFINES += HAVE_BAGL HAVE_SPRINTF HAVE_SNPRINTF_FORMAT_U
DEFINES += HAVE_IO_USB HAVE_L4_USBLIB IO_USB_MAX_ENDPOINTS=6 IO_HID_EP_LENGTH=64 HAVE_USB_APDU
DEFINES += USB_SEGMENT_SIZE=64

DEFINES += HAVE_WEBUSB WEBUSB_URL_SIZE_B=0 WEBUSB_URL=""

ifeq ($(TARGET_NAME),TARGET_NANOS)
    ICON_NANOS = glyphs/icon_xeris_nanos.gif
    DEFINES += IO_SEPROXYHAL_BUFFER_SIZE_B=128
else ifeq ($(TARGET_NAME),TARGET_NANOX)
    ICON_NANOX = glyphs/icon_xeris_nanox.gif
    DEFINES += HAVE_BLE BLE_COMMAND_TIMEOUT_MS=2000 HAVE_BLE_APDU
    DEFINES += IO_SEPROXYHAL_BUFFER_SIZE_B=300
    SDK_SOURCE_PATH += lib_blewbxx lib_blewbxx_impl
else ifeq ($(TARGET_NAME),TARGET_NANOS2)
    ICON_NANOSP = glyphs/icon_xeris_nanox.gif
    DEFINES += HAVE_BLE BLE_COMMAND_TIMEOUT_MS=2000 HAVE_BLE_APDU
    DEFINES += IO_SEPROXYHAL_BUFFER_SIZE_B=300
    SDK_SOURCE_PATH += lib_blewbxx lib_blewbxx_impl
else ifeq ($(TARGET_NAME),TARGET_STAX)
    ICON_STAX = glyphs/icon_xeris_stax_32px.gif
    DEFINES += IO_SEPROXYHAL_BUFFER_SIZE_B=300
    DEFINES += HAVE_BLE BLE_COMMAND_TIMEOUT_MS=2000 HAVE_BLE_APDU
    DEFINES += NBGL_QRCODE NBGL_KEYBOARD NBGL_USE_CASE
    SDK_SOURCE_PATH += lib_blewbxx lib_blewbxx_impl
else ifeq ($(TARGET_NAME),TARGET_FLEX)
    ICON_FLEX = glyphs/icon_xeris_stax_32px.gif
    DEFINES += IO_SEPROXYHAL_BUFFER_SIZE_B=300
    DEFINES += HAVE_BLE BLE_COMMAND_TIMEOUT_MS=2000 HAVE_BLE_APDU
    DEFINES += NBGL_QRCODE NBGL_KEYBOARD NBGL_USE_CASE
    SDK_SOURCE_PATH += lib_blewbxx lib_blewbxx_impl
endif

DEFINES += HAVE_UX_FLOW

CC      := $(CLANGPATH)clang
CFLAGS  += -Wall -Wextra -Werror -Wno-unused-parameter
CFLAGS  += -I$(BOLOS_SDK)/include
CFLAGS  += -Isrc

AS      := $(GCCPATH)arm-none-eabi-gcc
LD      := $(GCCPATH)arm-none-eabi-gcc
LDFLAGS += -O3 -Os
LDLIBS  += -lm -lgcc -lc

SOURCE_PATH     = src
SDK_SOURCE_PATH += lib_standard_app

INCLUDES_PATH += $(BOLOS_SDK)/lib_standard_app

include $(BOLOS_SDK)/Makefile.glyphs
include $(BOLOS_SDK)/Makefile.rules

dep/%.d: %.c Makefile

listvariants:
	@echo VARIANTS COIN xeris
